<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Job Applications</h1>
  <%= link_to "New Job Application", new_job_application_path,
        class: "text-sm bg-indigo-600 text-white px-3 py-1.5 rounded hover:bg-indigo-700" %>
</div>

<% if @job_applications.empty? %>
  <p class="text-gray-500">No job applications found.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Company</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Role</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Status</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Applied</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @job_applications.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900">
              <%= link_to job.company, job_application_path(job), class: "hover:text-indigo-600" %>
            </td>
            <td class="px-4 py-3 text-gray-700"><%= job.role_title %></td>
            <td class="px-4 py-3">
              <span class="<%= status_badge_class(job.status) %> px-2 py-0.5 rounded-full text-xs font-medium">
                <%= job.status_label %>
              </span>
              <%= form_with url: status_job_application_path(job), method: :patch,
                    scope: :job_application, class: "inline-flex items-center gap-2 ml-2" do |form| %>
                <%= form.label :status, "Status for #{job.company}",
                      for: "job_application_#{job.id}_status", class: "sr-only" %>
                <%= form.select :status,
                      JobApplication.statuses.keys.map { |code| [ JobTracker::StatusCatalog.label(code), code ] },
                      { selected: job.status },
                      id: "job_application_#{job.id}_status",
                      class: "border border-gray-300 rounded px-2 py-1 text-xs bg-white" %>
                <%= form.submit "Update #{job.company}",
                      class: "text-xs text-indigo-600 hover:underline cursor-pointer bg-transparent border-0 p-0" %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= job.apply_date %></td>
            <td class="px-4 py-3 text-right space-x-2">
              <%= link_to "Edit", edit_job_application_path(job), class: "text-xs text-indigo-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
