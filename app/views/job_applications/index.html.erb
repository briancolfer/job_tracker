<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Job Applications</h1>

  <% if @job_applications.empty? %>
    <p class="text-gray-500">No job applications found.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-gray-600">Company</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600">Role</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600">Status</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600">Applied</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 bg-white">
          <% @job_applications.each do |job| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-900"><%= job.company %></td>
              <td class="px-4 py-3 text-gray-700"><%= job.role_title %></td>
              <td class="px-4 py-3 text-gray-700"><%= job.status %></td>
              <td class="px-4 py-3 text-gray-500"><%= job.apply_date %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
